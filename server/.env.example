# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env al repositorio.

# --- Obligatorias ---
# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Normalmente empieza con "AIzaSy...".
GEMINI_API_KEY=

# Secreto para firmar los tokens de sesión (JWT).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Opcionales (tienen valor por defecto) ---
PORT=4000
NODE_ENV=development

# Modelo de Gemini por defecto para todo.
# Se deja el alias "-latest" (no una versión fija como "gemini-2.5-flash")
# porque Google va retirando versiones concretas para cuentas nuevas cada
# tanto; el alias siempre apunta al modelo Flash vigente sin que haya que
# tocar esto de nuevo.
GEMINI_MODEL=gemini-flash-latest

# Modelo por función (opcional). Si no los pone, las tres usan GEMINI_MODEL.
#
# Guía de costo aproximada (por millón de tokens, entrada/salida — verifique
# el precio vigente en https://ai.google.dev/gemini-api/docs/pricing):
#   gemini-pro-latest        más caro, la mejor calidad — necesita facturación
#                            activada en el proyecto (falla con 429 en el
#                            plan gratis sin tarjeta asociada)
#   gemini-flash-latest      el equilibrio recomendado, funciona en el plan gratis
#   gemini-flash-lite-latest el más barato y rápido
#
# La rutina y el plan de comidas se generan pocas veces por persona y ahí la
# calidad se nota, así que conviene dejarlos en Flash (o subir a Pro si activó
# facturación). El chat es el que más se usa: si quiere bajar la cuenta, ese es
# el que vale la pena bajar a Flash-Lite.
# GEMINI_MODEL_ROUTINE=gemini-flash-latest
# GEMINI_MODEL_NUTRITION=gemini-flash-latest
# GEMINI_MODEL_CHAT=gemini-flash-lite-latest

# Ruta del fichero SQLite (relativa a server/ o absoluta).
DATABASE_PATH=./data/app.db

# Duración del token de sesión.
JWT_EXPIRES_IN=30d

# Orígenes permitidos para CORS, separados por coma. "*" permite todos.
CORS_ORIGIN=*
